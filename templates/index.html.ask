<!doctype html>
<html>

<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>ESP32 temperature probe</title>
  <script src="./form.js"></script>
  <link rel="stylesheet" href="./index.css">
</head>

<body>
<main class="app">
<section class="panel">
<h1>ESP32 temperature probe</h1>
<p>Firmware version {{ crate::FW_VERSION }}</p>
<div id="uptime">Uptime: - - -</div>
</section>

<section class="panel" aria-labelledby="ota-details-title">
<h2 id="ota-details-title">OTA details</h2>
{% let ota = askama::get_value::<crate::OtaDetails>("ota_details")? %}
<div class="ota-details-grid">
  <div>
    <h3>Application</h3>
    <dl class="ota-details-list">
      <dt>Firmware version</dt><dd>{{ ota.application_version }}</dd>
      <dt>ESP-IDF version</dt><dd>{{ ota.application_idf_version }}</dd>
      <dt>Rollback in app build</dt><dd>{% if ota.application_rollback_enabled %}Enabled{% else %}Disabled{% endif %}</dd>
      <dt>Image state at boot</dt><dd>{{ ota.running_state_at_boot }}</dd>
    </dl>
  </div>
  <div>
    <h3>Installed bootloader</h3>
    {% match ota.bootloader %}
    {% when Some with (bootloader) %}
    <dl class="ota-details-list">
      <dt>Version</dt><dd>{{ bootloader.version }}</dd>
      <dt>ESP-IDF version</dt><dd>{{ bootloader.idf_version }}</dd>
      <dt>Build date / time</dt><dd>{{ bootloader.built_at }}</dd>
      <dt>Security version</dt><dd>{{ bootloader.secure_version }}</dd>
    </dl>
    {% when None %}
    <p>Bootloader description unavailable.</p>
    {% match ota.bootloader_error %}
    {% when Some with (error) %}<p>{{ error }}</p>
    {% when None %}
    {% endmatch %}
    {% endmatch %}
  </div>
</div>
<div class="ota-slot-list">
{% let slots = [
    ("Running slot", &ota.running_slot),
    ("Next boot slot", &ota.boot_slot),
    ("Update target", &ota.update_slot)
] %}
{% for (title, slot) in slots %}
  <div class="ota-slot">
    <h3>{{ title }}</h3>
    {% match slot %}
    {% when Some with (slot) %}
    <p><code>{{ slot.label }}</code> <span class="ota-state">{{ slot.state }}</span></p>
    <p>{{ slot.size_bytes / 1024 }} KiB · offset <code>{{ "0x{:X}"|format(slot.address) }}</code></p>
    {% when None %}
    <p>Unavailable</p>
    {% endmatch %}
  </div>
{% endfor %}
</div>
<p class="ota-note">Bootloader rollback: {{ ota.bootloader_rollback }}.</p>
<p class="ota-note">Details captured at startup. The application build setting does not describe the installed bootloader.</p>
{% match ota.probe %}
{% when Some with (probe) %}
<h3>Controlled rollback probe</h3>
<p>{{ probe.message }}</p>
{% if probe.can_test_fallback %}
<p>The fallback test will restart this image without confirmation. Expect the previous firmware to return.</p>
<form action="/ota-test/rollback" method="POST" name="otaProbe">
  <input type="submit" value="Test fallback to previous firmware">
</form>
{% endif %}
{% when None %}
{% endmatch %}
</section>

<section class="panel">
<h2>Settings</h2>
{% let myform = [
    ("text", "wifi_ssid", wifi_ssid.to_string(), "WiFi SSID"),
    ("checkbox", "wifi_wpa2ent", wifi_wpa2ent.to_string(), "WPA2 Enterprise"),
    ("text", "wifi_username", wifi_username.to_string(), "WPA2 Enterprise username"),
    ("password", "wifi_pass", wifi_pass.to_string(), "WiFi password"),
    ("checkbox", "v4dhcp", v4dhcp.to_string(), "Use DHCP"),
    ("text", "v4addr", v4addr.to_string(), "IPv4 address"),
    ("text", "v4mask", v4mask.to_string(), "IPv4 mask length (0-30)"),
    ("text", "v4gw", v4gw.to_string(), "IPv4 gateway"),
    ("text", "dns1", dns1.to_string(), "DNS 1"),
    ("text", "dns2", dns2.to_string(), "DNS 2"),
    ("checkbox", "esphome_enable", esphome_enable.to_string(), "ESPHome API enabled"),
    ("checkbox", "mqtt_enable", mqtt_enable.to_string(), "MQTT enabled"),
    ("text", "mqtt_url", mqtt_url.to_string(), "MQTT URL"),
    ("text", "mqtt_topic", mqtt_topic.to_string(), "MQTT topic prefix"),
    ("text", "retries", retries.to_string(), "Sensor read retries"),
    ("text", "delay", delay.to_string(), "Sensor poll interval (s)")
] -%}
<form action="/config" method="POST" name="esp32cfg">
    <table>
{%- for (itype, name, value, descr) in myform %}
        <tr>
{%- if *itype == "checkbox" %}
            <th><label for="{{name}}">{{descr}}:</label></th>
            <th><input name="{{name}}" type="{{itype}}"{% if value == "true" %} checked{% endif %}></th>
{%- else %}
            <th><label for="{{name}}">{{descr}}:</label></th>
            <th><input name="{{name}}" type="{{itype}}" value="{{value}}"></th>
{%- endif %}
        </tr>
{%- endfor %}
    </table>
    <input type="submit" value="Submit">
</form>
</section>

<section class="panel danger">
<h2>OTA firmware update (DANGER)</h2>
<form action="/fw" method="POST" name="esp32fw">
  <label for="firmware">Firmware URL:</label>
  <input type="text" id="firmware" name="url" placeholder="http://">
  <input type="submit" value="Update!">
</form>
</section>

<section class="panel">
<h2>Detected sensors</h2>
<div id="detected-sensors">- - -</div>
</section>

<section class="panel">
<h2>Temperatures</h2>
<div id="temperatures">- - -</div>
</section>
</main>
</body>
</html>
